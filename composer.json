{
    "name": "mpge/laravel-openid-provider",
    "description": "Turn a Laravel application into a small, spec-compliant OpenID Connect provider built on Laravel Passport.",
    "keywords": [
        "laravel",
        "passport",
        "openid",
        "openid-connect",
        "oidc",
        "oauth2",
        "identity-provider",
        "sso"
    ],
    "homepage": "https://github.com/mpge/laravel-openid-provider",
    "license": "MIT",
    "authors": [
        {
            "name": "Matthew Gros",
            "homepage": "https://github.com/mpge"
        }
    ],
    "support": {
        "issues": "https://github.com/mpge/laravel-openid-provider/issues",
        "source": "https://github.com/mpge/laravel-openid-provider",
        "security": "https://github.com/mpge/laravel-openid-provider/security/policy"
    },
    "require": {
        "php": "^8.3",
        "ext-json": "*",
        "ext-openssl": "*",
        "illuminate/auth": "^12.0|^13.0",
        "illuminate/console": "^12.0|^13.0",
        "illuminate/contracts": "^12.0|^13.0",
        "illuminate/database": "^12.0|^13.0",
        "illuminate/http": "^12.0|^13.0",
        "illuminate/routing": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "illuminate/view": "^12.0|^13.0",
        "laravel/passport": "^13.0",
        "lcobucci/jwt": "^5.0",
        "league/oauth2-server": "^9.0",
        "nyholm/psr7": "^1.8",
        "phpseclib/phpseclib": "^4.0",
        "psr/http-message": "^1.1|^2.0",
        "symfony/psr-http-message-bridge": "^7.0|^8.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.18",
        "orchestra/testbench": "^10.0|^11.0",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^11.5|^12.0"
    },
    "autoload": {
        "psr-4": {
            "Mpge\\OpenIdProvider\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Mpge\\OpenIdProvider\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/",
            "Workbench\\Database\\Factories\\": "workbench/database/factories/",
            "Workbench\\Database\\Seeders\\": "workbench/database/seeders/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --memory-limit=1G",
        "format": "pint",
        "lint": "pint --test",
        "serve": [
            "@php vendor/bin/testbench workbench:build --ansi",
            "@php vendor/bin/testbench serve --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "Mpge\\OpenIdProvider\\OpenIdProviderServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
